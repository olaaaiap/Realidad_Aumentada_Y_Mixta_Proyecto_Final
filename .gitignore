# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
Motion_Care/[Ll]ibrary/
Motion_Care/[Tt]emp/
Motion_Care/[Oo]bj/
Motion_Care/[Bb]uild/
Motion_Care/[Bb]uilds/
Motion_Care/[Ll]ogs/
Motion_Care/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
Motion_Care/[Mm]emoryCaptures/

# Recordings can get excessive in size
Motion_Care/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
Motion_Care/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/
Motion_Care/.vs/

# Gradle cache directory
.gradle/
Motion_Care/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
Motion_Care/ExportedObj/
Motion_Care/.consulo/
Motion_Care/*.csproj
Motion_Care/*.unityproj
Motion_Care/*.sln
Motion_Care/*.suo
Motion_Care/*.tmp
Motion_Care/*.user
Motion_Care/*.userprefs
Motion_Care/*.pidb
Motion_Care/*.booproj
Motion_Care/*.svd
Motion_Care/*.pdb
Motion_Care/*.mdb
Motion_Care/*.opendb
Motion_Care/*.VC.db

# Unity3D generated meta files
Motion_Care/*.pidb.meta
Motion_Care/*.pdb.meta
Motion_Care/*.mdb.meta

# Unity3D generated file on crash reports
Motion_Care/sysinfo.txt

# Builds
Motion_Care/*.apk
Motion_Care/*.aab
Motion_Care/*.unitypackage
Motion_Care/*.unitypackage.meta
Motion_Care/*.app

# Crashlytics generated file
Motion_Care/crashlytics-build.properties

# Packed Addressables
Motion_Care/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
Motion_Care/[Aa]ssets/[Ss]treamingAssets/aa.meta
Motion_Care/[Aa]ssets/[Ss]treamingAssets/aa/*
